# Kopiera den här filen till .env och fyll i. .env checkas aldrig in (se .gitignore).

# Server och databas
NODE_ENV=
PORT=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Inloggning (JWT)
JWT_SECRET=
JWT_EXPIRES_IN=

# Bekräftelsemejl efter bokning (Nodemailer + SMTP).
# Är de här tomma skickas inga mejl, men bokningen fungerar ändå.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Webbplatsens adress, används för länken till /login i mejlet (tomt = http://localhost:5173)
APP_URL=
